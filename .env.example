# Credenciais locais do MetaTrader 5 — nunca publique valores reais.
MT5_LOGIN=
MT5_SENHA=
MT5_SERVIDOR=
MT5_CAMINHO=
MT5_MAGIC=234001

# Diretórios locais de métricas; podem ser mantidos nos padrões do projeto.
# ALFA_ACCURACY_DIR=
# ALFA_ML_METRICS_DIR=

# Janela histórica e treinamento.
ALFA_TRAIN_START=2018-01-01
ALFA_VALIDATION_START=2024-01-01
ALFA_TEST_START=2026-01-01
# ALFA_DATA_END=YYYY-MM-DD
ALFA_HISTORY_CHUNK_DAYS=180
ALFA_MAX_LSTM_SEQUENCES_PER_ASSET=50000
ALFA_LABEL_HORIZON_BARS=5
ALFA_FEATURE_LOOKBACK=250

# Custos e limites do backtest.
ALFA_BACKTEST_LOTS=0.01
ALFA_BACKTEST_SPREAD_POINTS=1.0
ALFA_BACKTEST_SLIPPAGE_POINTS=0.0
ALFA_BACKTEST_COMMISSION_PER_LOT=0.0
ALFA_BACKTEST_MAX_HOLD_BARS=30

# Proteções de execução; ajuste somente após validação em conta demo.
ALFA_MIN_LOTS=0.01
ALFA_MAX_LOTS=0.01
ALFA_MAX_SPREAD_POINTS=25
ALFA_MAX_SLIPPAGE_POINTS=10
ALFA_ORDER_DEVIATION_POINTS=10
ALFA_COMMISSION_PER_LOT=0.0
ALFA_MIN_NET_EDGE=0.0
ALFA_COST_BUFFER_POINTS=2.0
ALFA_MAX_TRADES_DIA=5
ALFA_MAX_TRADES_HORA=1
ALFA_MAX_POSICOES_POR_ATIVO=1
ALFA_MAX_POSICOES_TOTAIS=1
ALFA_STOP_DAILY_LOSS_PCT=1.0
ALFA_MAX_DRAWDOWN_PCT=3.0
ALFA_REQUIRE_TRAINED_MODEL=1

# Advisor, capacidade e acompanhamento de posição.
ALFA_ADVISOR_ENABLED=1
ALFA_DYNAMIC_CAPACITY_ENABLED=1
ALFA_PORTFOLIO_RISK_BUDGET_PCT=1.0
ALFA_REINVEST_PROFIT_PCT=0.0
ALFA_HARD_MAX_POSITIONS=1
ALFA_HARD_MAX_POSITIONS_PER_ASSET=1
ALFA_EXIT_MANAGER_ENABLED=1
ALFA_EXIT_CHECK_SECONDS=2.0
ALFA_SIGNAL_REPEAT_COOLDOWN_SECONDS=300

# Diagnóstico e logs.
ALFA_MULTI_ASSET_DIAGNOSTICS=1
ALFA_CONSOLE_MODE=compact
LOG_LEVEL=INFO

# Importante: esta versão contém caminhos que podem enviar ordens pelo MT5.
# Não existe um parâmetro ALFA_DRY_RUN implementado no código atual.
